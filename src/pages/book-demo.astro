---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkyHero from '../components/SkyHero.astro';
import PageIntro from '../components/PageIntro.astro';
import { routes } from '../data/site';

const calBase = 'https://cal.com/isabella-kulstad-6hk2qf/30min';

const agenda = [
  { time: '5 min', title: 'Your campus today', body: 'How students currently find support, and what you’d like to change.' },
  { time: '15 min', title: 'Sky, set up for a campus like yours', body: 'A live walkthrough of the student experience and how resources are mapped.' },
  { time: '10 min', title: 'Security & next steps', body: 'HECVAT, privacy, pilot timeline — and any questions from your team.' },
];

const hosts = [
  { initials: 'IK', name: 'Isabella Kulstad', role: 'Founder & CEO' },
  { initials: '[ ]', name: '[Cofounder name]', role: 'Cofounder & CTO' },
];

const badges = ['HECVAT compliant', 'End-to-end encrypted', 'Built in house'];

const bookingNotes = [
  'Cal.com shows Isabella’s real, live availability.',
  'Your confirmation and video link arrive by email right away.',
  'Add teammates as guests when you book — or forward the invite.',
];

const faqs: { q: string; a: string; link?: { href: string; label: string } }[] = [
  { q: 'Is the demo free?', a: 'Yes — no cost and no commitment.' },
  { q: 'Who should join?', a: 'Anyone involved in supporting survivors or approving tools: Title IX, student affairs, counseling, IT or procurement.' },
  { q: 'Can we see it with our own resources?', a: 'Yes. Share your campus resource list ahead of time and we’ll tailor the walkthrough so you see Sky pointing to your own offices and hotlines.' },
  { q: 'Can’t find a time that works?', a: ' and we’ll find one that fits.', link: { href: routes.contact, label: 'Send us a message' } },
];

/* The next five weekdays. Rendered at build time so the page has a sensible
   first paint, then recomputed in the browser from the visitor's own date. */
const nextWeekdays = (from: Date) => {
  const out: Date[] = [];
  const d = new Date(from);
  d.setHours(12, 0, 0, 0);
  while (out.length < 5) {
    d.setDate(d.getDate() + 1);
    const w = d.getDay();
    if (w !== 0 && w !== 6) out.push(new Date(d));
  }
  return out;
};
const pad = (n: number) => (n < 10 ? '0' : '') + n;
const calHref = (d: Date) => {
  const ym = `${d.getFullYear()}-${pad(d.getMonth() + 1)}`;
  return `${calBase}?month=${ym}&date=${ym}-${pad(d.getDate())}`;
};
const days = nextWeekdays(new Date());
const first = days[0];
---
<BaseLayout title="Book a demo" description="Pick a time that works. We’ll show you exactly how Sky would support your students — and answer every question your team has.">
  <SkyHero
    clouds={[
      { top: 150, width: 270, duration: 88, delay: -60 },
      { top: 60, width: 150, duration: 66, delay: -20 },
    ]}
    shoots={[{ top: 110, left: '30%' }]}
  >
    <PageIntro
      pill="30-minute walkthrough · Free"
      align="start"
      pad={[48, 220]}
      gap={18}
      titleSize="clamp(2.4rem, 4.8vw, 4rem)"
      titleMaxWidth="16ch"
      leadSize={19}
      leadMaxWidth="36rem"
      lead="Pick a time that works. We’ll show you exactly how Sky would support your students — and answer every question your team has."
    >
      <Fragment slot="title">See Cloud IX <span class="glowtext hl">on your campus.</span></Fragment>
    </PageIntro>
  </SkyHero>

  <section class="container booking">
    <div class="about">
      <div class="agenda">
        <h2 class="sub-h">What we’ll cover</h2>
        {agenda.map((a) => (
          <div class="agenda__row">
            <span class="agenda__time">{a.time}</span>
            <div class="agenda__text"><span class="strong">{a.title}</span><span class="small">{a.body}</span></div>
          </div>
        ))}
      </div>

      <div class="hosts">
        <h2 class="sub-h">Who you’ll meet</h2>
        <div class="hosts__row">
          {hosts.map((h) => (
            <div class="host">
              <span class="host__avatar" aria-hidden="true">{h.initials}</span>
              <div class="host__text"><span class="strong">{h.name}</span><span class="host__role">{h.role}</span></div>
            </div>
          ))}
        </div>
      </div>

      <div class="badges">
        {badges.map((b) => (
          <span class="badge"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7"></path></svg>{b}</span>
        ))}
      </div>

      <p class="small hecvat">Need security documentation first? <a href={routes.hecvat}>Request our HECVAT →</a></p>
    </div>

    <div class="card scheduler" data-scheduler data-cal-base={calBase}>
      <div class="scheduler__head">
        <span class="tile scheduler__tile" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"></rect><path d="M8 2v4M16 2v4M3 10h18"></path></svg></span>
        <div class="scheduler__who"><span class="scheduler__name">Book with Isabella Kulstad</span><span class="host__role">30-minute video call · scheduled through Cal.com</span></div>
      </div>

      <div class="scheduler__bar">
        <h2 id="sched-h" class="scheduler__h">Choose a day</h2>
        <span class="host__role"><span data-month>{first.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</span> · times shown in <span data-tz>your time zone</span></span>
      </div>

      <div role="radiogroup" aria-labelledby="sched-h" class="days" data-days>
        {days.map((d, i) => (
          <button type="button" role="radio" class="day" aria-checked={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-day={i}>
            <span class="day__dow">{d.toLocaleDateString('en-US', { weekday: 'short' })}</span>
            <span class="day__num">{d.getDate()}</span>
          </button>
        ))}
      </div>

      <a class="btn open-times" href={calHref(first)} target="_blank" rel="noopener" data-cal-link>
        <span>See open times for <span data-day-label>{first.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' })}</span></span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
      <a class="full-cal" href={calBase} target="_blank" rel="noopener">Or browse the full calendar</a>

      <ul class="notes">
        {bookingNotes.map((n) => (
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563A8" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5L20 7"></path></svg><span>{n}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="dfaq-h" class="container dfaq">
    <h2 id="dfaq-h" class="dfaq__h">Before you book</h2>
    <div class="dfaq__grid">
      {faqs.map((f) => (
        <div class="card panel dfaq__card">
          <h3 class="dfaq__q">{f.q}</h3>
          <p class="dfaq__a">{f.link && <a href={f.link.href}>{f.link.label}</a>}{f.a}</p>
        </div>
      ))}
    </div>
    <p class="text-2 dfaq__foot">Not a university? For partnerships, press or anything else, <a href={routes.contact}>contact us here</a>.</p>
  </section>
</BaseLayout>

<style>
  .strong { font-weight: 700; color: var(--night); }
  .small { font-size: 15px; color: var(--ink-2); }

  /* The booking card overlaps the bottom of the hero band. */
  .booking {
    position: relative; z-index: 2; margin-top: -170px; padding-bottom: 96px;
    display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-start;
  }

  .about { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 28px; padding-top: 200px; }
  .sub-h { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 26px; color: var(--night); }
  .agenda { display: flex; flex-direction: column; gap: 16px; }
  .agenda__row { display: flex; gap: 16px; align-items: flex-start; }
  .agenda__time {
    flex: none; min-width: 64px; text-align: center; padding: 6px 10px; border-radius: 999px;
    background: var(--tint); color: #174A82; font-weight: 700; font-size: 14px;
  }
  .agenda__text { display: flex; flex-direction: column; gap: 2px; }

  .hosts { display: flex; flex-direction: column; gap: 14px; }
  .hosts__row { display: flex; flex-wrap: wrap; gap: 20px; }
  .host { display: flex; gap: 12px; align-items: center; }
  .host__avatar {
    flex: none; width: 52px; height: 52px; border-radius: 50%; box-sizing: border-box;
    background: var(--tint); color: #174A82; display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-weight: 600; font-size: 18px;
    border: 3px solid #FFFFFF; box-shadow: 0 4px 12px rgba(37, 99, 168, 0.18);
  }
  .host__text { display: flex; flex-direction: column; }
  .host__role { font-size: 14px; color: var(--muted); }

  .badges { display: flex; flex-wrap: wrap; gap: 8px; }
  .badge {
    display: inline-flex; gap: 6px; align-items: center; padding: 8px 14px; border-radius: 999px;
    background: var(--surface); border: 1px solid var(--line); font-size: 14px; font-weight: 600; color: #174A82;
  }
  .hecvat { margin: 0; }
  .hecvat a, .full-cal, .dfaq a { font-weight: 700; }

  /* ---------- Scheduler card ---------- */
  .scheduler {
    flex: 1.25 1 540px; min-width: 0; box-sizing: border-box;
    background: var(--surface); border: 1px solid var(--line-strong); border-radius: 32px; padding: 36px;
    box-shadow: 0 30px 80px rgba(37, 99, 168, 0.18);
    display: flex; flex-direction: column; gap: 22px;
  }
  .scheduler__head { display: flex; gap: 14px; align-items: center; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
  .scheduler__tile {
    flex: none; width: 52px; height: 52px; border-radius: 16px;
    background: var(--tint); color: #174A82; display: flex; align-items: center; justify-content: center;
  }
  .scheduler__who { display: flex; flex-direction: column; }
  .scheduler__name { font-family: var(--font-display); font-weight: 600; font-size: 20px; color: var(--night); }
  .scheduler__bar { display: flex; flex-wrap: wrap; gap: 8px; justify-content: space-between; align-items: baseline; }
  .scheduler__h { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 24px; color: var(--night); }

  .days { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 10px; }
  .day {
    display: flex; flex-direction: column; align-items: center; gap: 2px;
    padding: 12px 4px; border-radius: 16px; font: inherit; cursor: pointer;
    color: var(--night); background: var(--page); border: 1.5px solid var(--line);
  }
  .day[aria-checked='true'] { color: #FFFFFF; background: var(--accent); border-color: var(--accent); }
  .day__dow { font-size: 13px; font-weight: 700; opacity: .8; }
  .day__num { font-family: var(--font-display); font-size: 24px; font-weight: 600; line-height: 1.6; }

  .open-times {
    display: flex; gap: 10px; align-items: center; justify-content: center; flex-wrap: wrap; text-align: center;
    color: #FFFFFF; background: var(--accent); padding: 16px 28px; border-radius: 999px;
    text-decoration: none; font-weight: 700; font-size: 17px;
  }
  .open-times:hover { color: #FFFFFF; }
  .full-cal { align-self: center; font-size: 15px; }

  .notes {
    margin: 0; padding: 18px 0 0; border-top: 1px solid var(--line); list-style: none;
    display: flex; flex-direction: column; gap: 10px; font-size: 15px; color: var(--ink-2);
  }
  .notes li { display: flex; gap: 10px; align-items: flex-start; }
  .notes svg { flex: none; margin-top: 3px; }

  /* ---------- Before you book ---------- */
  .dfaq { position: relative; padding-bottom: 112px; display: flex; flex-direction: column; gap: 28px; }
  .dfaq__h { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: clamp(1.8rem, 3vw, 2.3rem); line-height: 1.2; letter-spacing: -0.02em; color: var(--night); }
  .dfaq__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; }
  .dfaq__card { border-radius: 22px; padding: 24px 26px; display: flex; flex-direction: column; gap: 6px; }
  .dfaq__q { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 19px; color: var(--night); }
  .dfaq__a { margin: 0; color: var(--ink-2); font-size: 16px; }
  .dfaq__foot { margin: 0; }

  @media (max-width: 520px) {
    .scheduler { padding: 28px 20px; }
    .days { gap: 6px; }
    .day__num { font-size: 22px; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-scheduler]');
  if (root) {
    const base = root.dataset.calBase ?? '';
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-day]'));
    const monthEl = root.querySelector<HTMLElement>('[data-month]');
    const tzEl = root.querySelector<HTMLElement>('[data-tz]');
    const dayLabelEl = root.querySelector<HTMLElement>('[data-day-label]');
    const link = root.querySelector<HTMLAnchorElement>('[data-cal-link]');

    // Next five weekdays from the visitor's own "today".
    const days: Date[] = [];
    const d = new Date();
    d.setHours(12, 0, 0, 0);
    while (days.length < 5) {
      d.setDate(d.getDate() + 1);
      const w = d.getDay();
      if (w !== 0 && w !== 6) days.push(new Date(d));
    }
    const pad = (n: number) => (n < 10 ? '0' : '') + n;

    try {
      const tz = new Intl.DateTimeFormat('en-US', { timeZoneName: 'short' })
        .formatToParts(new Date())
        .find((p) => p.type === 'timeZoneName')?.value;
      if (tz && tzEl) tzEl.textContent = tz;
    } catch {
      /* keep "your time zone" */
    }

    buttons.forEach((btn, i) => {
      const day = days[i];
      const [dow, num] = btn.querySelectorAll('span');
      dow.textContent = day.toLocaleDateString('en-US', { weekday: 'short' });
      num.textContent = String(day.getDate());
      btn.setAttribute('aria-label', day.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' }));
    });

    const select = (i: number) => {
      const sel = days[i];
      const ym = `${sel.getFullYear()}-${pad(sel.getMonth() + 1)}`;
      buttons.forEach((btn, t) => {
        btn.setAttribute('aria-checked', String(t === i));
        btn.tabIndex = t === i ? 0 : -1;
      });
      if (monthEl) monthEl.textContent = sel.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
      if (dayLabelEl) dayLabelEl.textContent = sel.toLocaleDateString('en-US', { weekday: 'long', month: 'short', day: 'numeric' });
      if (link) link.href = `${base}?month=${ym}&date=${ym}-${pad(sel.getDate())}`;
    };

    buttons.forEach((btn, i) => {
      btn.addEventListener('click', () => select(i));
      btn.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        const next = (i + step + buttons.length) % buttons.length;
        select(next);
        buttons[next].focus();
      });
    });

    select(0);
  }
</script>
