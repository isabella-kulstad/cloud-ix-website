---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkyHero from '../components/SkyHero.astro';
import PageIntro from '../components/PageIntro.astro';
import Button from '../components/Button.astro';
import Cloud from '../components/Cloud.astro';
import { routes } from '../data/site';

/** Founding-partner placeholder section (off by default in the design). */
const showFounding = false;

const check = '<path d="m5 12 5 5L20 7"></path>';

const tracks = [
  {
    id: 'advocates',
    title: 'Advocates, influencers & activists',
    blurb: 'Voices who’ve spent years doing this work — survivors, creators, organizers and educators.',
    icon: '<path d="M3 11v2a1 1 0 0 0 1 1h2l5 4V6L6 10H4a1 1 0 0 0-1 1Z"></path><path d="M15.5 8.5a5 5 0 0 1 0 7"></path><path d="M18.5 5.5a9 9 0 0 1 0 13"></path>',
    heading: 'Your voice shapes what we build.',
    lead: 'Survivors and advocates know what students need better than any product team. Our partnerships are volunteer collaborations: we bring you in early, credit your work, and make sure your time shapes what we build.',
    items: [
      { title: 'Survivor-informed review', body: 'Help us test Sky’s language, tone and answers before they reach students.' },
      { title: 'Co-created campaigns', body: 'Content and awareness pushes — Sexual Assault Awareness Month in April, back-to-school season and more.' },
      { title: 'Campus ambassadors', body: 'Students and recent grads who bring Cloud IX to their schools.' },
      { title: 'Speaking & events', body: 'Panels, workshops and conversations we host or join together.' },
    ],
    offer: [
      'Advisory sessions where your feedback directly shapes Sky',
      'Public credit for your contributions — or anonymity if you prefer',
      'Early access to new features',
    ],
    ask: [
      'Honest feedback, even when it’s hard to hear',
      'Care with survivor stories — always shared with consent',
      'Alignment with our survivor-centered principles',
    ],
  },
  {
    id: 'organizations',
    title: 'Organizations & nonprofits',
    blurb: 'Rape crisis centers, hotlines, advocacy groups and campus-focused nonprofits.',
    icon: '<path d="M3 21h18"></path><path d="M5 21V8l7-5 7 5v13"></path><path d="M9 21v-6h6v6"></path>',
    heading: 'Your services, one tap closer.',
    lead: 'Sky already points students to local and national support. Partnering lets us do it accurately — with your current hours, language and referral process.',
    items: [
      { title: 'Resource partnership', body: 'Your organization listed and kept up to date inside Cloud IX, so students reach you directly.' },
      { title: 'Language & training review', body: 'Your advocates help shape how Sky describes support, reporting and next steps.' },
      { title: 'Anonymized trend insights', body: 'Aggregate patterns in what students ask, to inform outreach and grant reporting. [Confirm]' },
      { title: 'Joint programs & grants', body: 'Co-host events, co-apply for funding, or pilot new support models together.' },
    ],
    offer: [
      'Accurate, warm referrals to your services',
      'Visibility on our site and campus materials',
      'Insights that never identify a student',
    ],
    ask: [
      'Up-to-date service information',
      'A point of contact for referral questions',
      'Shared commitment to student confidentiality',
    ],
  },
  {
    id: 'movements',
    title: 'Movements & coalitions',
    blurb: 'Student groups, national campaigns and coalitions pushing for safer campuses.',
    icon: '<circle cx="7" cy="8" r="3"></circle><circle cx="17" cy="8" r="3"></circle><path d="M2 20c.8-3 2.8-5 5-5s4.2 2 5 5"></path><path d="M12 20c.8-3 2.8-5 5-5s4.2 2 5 5"></path>',
    heading: 'Bigger than one platform.',
    lead: 'Safer campuses take students, organizers and coalitions pushing together. We want to show up for that work — not just ask it to show up for us.',
    items: [
      { title: 'Student organizations', body: 'Support for campus groups running prevention, awareness and advocacy work.' },
      { title: 'Coalitions & networks', body: 'Join coalitions working on campus sexual violence and Title IX.' },
      { title: 'Awareness campaigns', body: 'Amplify national days of action and campaigns with our tools and channels.' },
      { title: 'Policy conversations', body: 'Share what we learn to inform conversations about campus safety policy. [Confirm scope]' },
    ],
    offer: [
      'Our platform and channels to amplify your campaigns',
      'Speakers and resources for student events',
      'Collaboration on research and storytelling',
    ],
    ask: [
      'Shared values around survivor autonomy',
      'Coordination on messaging and timing',
      'Openness to building long-term',
    ],
  },
];

const principles = [
  { title: 'Survivor-centered', body: 'Every collaboration starts with what’s best for survivors — not for us.' },
  { title: 'Credit where it’s due', body: 'Partnerships are volunteer, not paid, so we make sure every contributor is named and credited for their time and expertise.' },
  { title: 'Privacy first', body: 'We never share information that could identify a student. Not with partners, not with anyone.' },
  { title: 'Honest about where we are', body: 'We’re new. We’ll tell you what we can and can’t do yet — and grow with you.' },
];

const steps = [
  { title: 'Reach out', body: 'Tell us who you are and the kind of collaboration you have in mind.' },
  { title: 'Intro call', body: 'We meet, listen, and figure out where our goals overlap.' },
  { title: 'Start small, build together', body: 'We shape a first collaboration — then grow it from there.' },
];
---
<BaseLayout title="Partners" description="Survivor support was built by advocates, activists and organizations long before Cloud IX existed. We want to earn our place by building with them.">
  <SkyHero
    clouds={[
      { top: 160, width: 300, duration: 95, delay: -45 },
      { top: 340, width: 180, duration: 70, delay: -10 },
    ]}
    shoots={[{ top: 120, left: '64%' }]}
  >
    <PageIntro
      pill="Partnerships"
      pad={[64, 240]}
      gap={22}
      titleSize="clamp(2.5rem, 5.2vw, 4.4rem)"
      titleMaxWidth="16ch"
      leadSize={20}
      leadMaxWidth="40rem"
      lead="Survivor support was built by advocates, activists and organizations long before Cloud IX existed. We’re new — and we want to earn our place by building with the people who’ve been doing this work all along."
    >
      <Fragment slot="title">Built <span class="glowtext hl">alongside</span> the movement.</Fragment>
      <Fragment slot="actions">
        <Button href="#tracks-h" size="lg">Ways to partner</Button>
        <Button href={routes.contact} variant="outline-white" size="lg">Start a conversation</Button>
      </Fragment>
    </PageIntro>
  </SkyHero>

  <!-- Tracks -->
  <section aria-labelledby="tracks-h" class="container tracks">
    <div class="heading">
      <span class="eyebrow eyebrow--deep">Three ways to partner</span>
      <h2 id="tracks-h" class="h2">Find where you fit</h2>
      <p class="lead">Choose a path to see how we work together.</p>
    </div>
    <div role="tablist" aria-label="Partnership types" class="track-tabs" data-tablist>
      {tracks.map((t, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${t.id}`}
          aria-controls={`panel-${t.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class="card track-tab"
        >
          <span class="tile track-tab__tile" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={t.icon}></svg></span>
          <span class="track-tab__title">{t.title}</span>
          <span class="track-tab__blurb">{t.blurb}</span>
        </button>
      ))}
    </div>
    <div class="track-panels">
      {tracks.map((t, i) => (
        <div role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} class="rise track-panel" hidden={i !== 0} tabindex="0">
          <div class="track-panel__intro">
            <h3 class="track-panel__title">{t.heading}</h3>
            <p class="lead">{t.lead}</p>
          </div>
          <ul class="track-items" role="list">
            {t.items.map((it) => (
              <li class="card track-item">
                <span class="track-item__title">{it.title}</span>
                <span class="track-item__body">{it.body}</span>
              </li>
            ))}
          </ul>
          <div class="terms">
            {[{ label: 'What we offer', list: t.offer }, { label: 'What we ask', list: t.ask }].map((col) => (
              <div class="terms__col">
                <span class="terms__label">{col.label}</span>
                <ul class="checks" role="list">
                  {col.list.map((line) => (
                    <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2563A8" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={check}></svg><span>{line}</span></li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Principles (night band) -->
  <section aria-labelledby="prin-h" class="principles">
    <div class="stars1" aria-hidden="true"></div>
    <svg class="spin-rev principles__ring" viewBox="0 0 620 620" aria-hidden="true"><circle cx="310" cy="310" r="300" fill="none" stroke="#8DBBF5" stroke-opacity="0.18" stroke-dasharray="2 10"></circle><circle cx="310" cy="310" r="220" fill="none" stroke="#8DBBF5" stroke-opacity="0.1"></circle><circle cx="310" cy="10" r="6" fill="#8DBBF5"></circle></svg>
    <div class="container principles__inner">
      <div class="heading">
        <span class="eyebrow eyebrow--dark">How we partner</span>
        <h2 id="prin-h" class="h2 on-dark">Our partnership principles</h2>
      </div>
      <ul class="principle-list" role="list">
        {principles.map((p) => (
          <li class="card principle">
            <span class="principle__title">{p.title}</span>
            <span class="principle__body">{p.body}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Process -->
  <section aria-labelledby="proc-h" class="container process">
    <div class="heading">
      <span class="eyebrow eyebrow--deep">Getting started</span>
      <h2 id="proc-h" class="h2">From hello to working together</h2>
    </div>
    <ol class="steps" role="list">
      {steps.map((s, i) => (
        <li class="card step">
          <div class="tile step__num" aria-hidden="true">{i + 1}</div>
          <span class="step__title"><span class="sr-only">Step {i + 1}: </span>{s.title}</span>
          <span class="step__body">{s.body}</span>
        </li>
      ))}
    </ol>
  </section>

  {showFounding && (
    <!-- Founding partners -->
    <section aria-labelledby="fp-h" class="container founding">
      <Cloud top={10} width={240} duration={105} delay={-40} fill="#D6E6F8" opacity={0.9} />
      <div class="heading heading--wide">
        <span class="eyebrow eyebrow--deep">Founding partners</span>
        <h2 id="fp-h" class="h2 h2--sm">Be one of the first.</h2>
        <p class="lead">We’re building our first circle of partners now. Founding partners help shape Cloud IX from the ground up — and will always be recognized here.</p>
      </div>
      <ul class="spots" role="list">
        {[0, 1, 2, 3].map(() => (
          <li class="spot">
            <svg width="44" height="34" viewBox="0 -3 40 31" aria-hidden="true"><path d="M11 26h20a8 8 0 0 0 1.2-15.9A10 10 0 0 0 13 8.2 9 9 0 0 0 11 26Z" fill="#BCD3EE"></path></svg>
            <span class="spot__title">Founding partner spot</span>
            <span class="spot__body">Your organization here</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- CTA -->
  <section aria-labelledby="pcta-h" class="cta">
    <div class="cta__card">
      <div class="stars1" aria-hidden="true"></div>
      <svg class="cta__horizon" viewBox="0 0 1100 640" aria-hidden="true"><ellipse cx="550" cy="640" rx="560" ry="560" fill="#FFFFFF"></ellipse><ellipse cx="550" cy="640" rx="560" ry="560" fill="none" stroke="#A9C9EE" stroke-width="2"></ellipse></svg>
      <Cloud top={40} width={210} duration={58} />
      <Cloud top={230} width={140} duration={44} delay={-22} />
      <h2 id="pcta-h" class="display cta__title">Let’s build safer campuses <span class="glowtext hl">together.</span></h2>
      <p class="cta__lead">Whether you lead an organization, a campaign or a community, we’d love to hear what you’re working on.</p>
      <div class="cta__actions">
        <Button href={routes.contact} size="lg">Become a partner</Button>
        <Button href={routes.howItWorks} variant="outline-white" size="lg">See how it works</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Partnership-type tabs: click or arrow keys switch the visible panel.
  document.querySelectorAll<HTMLElement>('[data-tablist]').forEach((list) => {
    const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(tab.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      });
      if (focus) tabs[index].focus();
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        let next = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % tabs.length;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = tabs.length - 1;
        if (next >= 0) {
          e.preventDefault();
          select(next, true);
        }
      });
    });
  });
</script>

<style>
  ul, ol { list-style: none; margin: 0; padding: 0; }
  [hidden] { display: none !important; }

  /* Outline buttons in the design sit on a white fill */

  .heading { position: relative; display: flex; flex-direction: column; gap: 12px; max-width: 40rem; }
  .heading--wide { max-width: 42rem; }
  .eyebrow--deep { color: var(--link-hover); }

  /* ---------- Tracks ---------- */
  .tracks { position: relative; padding-top: 40px; padding-bottom: 96px; display: flex; flex-direction: column; gap: 32px; }
  .track-tabs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr)); gap: 20px; }
  .track-tab {
    font: inherit; text-align: left; cursor: pointer;
    display: flex; flex-direction: column; align-items: flex-start; gap: 12px; padding: 28px; border-radius: 24px;
    background: #FFFFFF; border: 2px solid var(--line);
  }
  .track-tab[aria-selected='true'] { border-color: var(--accent); box-shadow: 0 16px 40px rgba(37, 99, 168, 0.2); }
  .track-tab__tile {
    width: 56px; height: 56px; border-radius: 16px; display: flex; align-items: center; justify-content: center;
    background: var(--tint); color: #174A82;
  }
  .track-tab[aria-selected='true'] .track-tab__tile { background: var(--accent); color: #FFFFFF; }
  .track-tab__title { font-family: var(--font-display); font-weight: 600; font-size: 21px; line-height: 1.6; color: var(--night); }
  .track-tab__blurb { color: var(--ink-2); font-size: 16px; line-height: 1.6; }

  .track-panels {
    background: #FFFFFF; border: 1px solid var(--line); border-radius: 32px; padding: 44px 40px;
    box-shadow: 0 24px 60px rgba(37, 99, 168, 0.12);
  }
  .track-panel { display: flex; flex-direction: column; gap: 28px; }
  .track-panel:focus { outline: none; }
  .track-panel:focus-visible { outline: 3px solid var(--accent); outline-offset: 8px; border-radius: 8px; }
  .track-panel__intro { display: flex; flex-direction: column; gap: 10px; max-width: 46rem; }
  .track-panel__title { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 28px; line-height: 1.2; color: var(--night); }
  .track-items { display: flex; flex-wrap: wrap; gap: 16px; }
  .track-item {
    flex: 1 1 240px; background: var(--page); border: 1px solid var(--line); border-radius: 20px; padding: 22px;
    display: flex; flex-direction: column; gap: 6px;
  }
  .track-item__title { font-family: var(--font-display); font-weight: 600; font-size: 18px; color: var(--night); }
  .track-item__body { color: var(--ink-2); font-size: 15px; }
  .terms { display: flex; flex-wrap: wrap; gap: 32px; }
  .terms__col { flex: 1 1 300px; display: flex; flex-direction: column; gap: 12px; }
  .terms__label { font-weight: 700; color: var(--night); }
  .checks { display: flex; flex-direction: column; gap: 10px; color: var(--ink); }
  .checks li { display: flex; gap: 12px; align-items: flex-start; }
  .checks svg { flex: none; margin-top: 4px; }

  /* ---------- Principles ---------- */
  .principles { position: relative; overflow: hidden; background: var(--night); }
  .principles__ring { position: absolute; bottom: -280px; right: -240px; width: 620px; height: 620px; opacity: 0.5; }
  .principles__inner { position: relative; padding-top: 96px; padding-bottom: 96px; display: flex; flex-direction: column; gap: 36px; }
  .principle-list { display: flex; flex-wrap: wrap; gap: 20px; }
  .principle {
    flex: 1 1 240px; background: rgba(27, 47, 94, 0.85); border: 1px solid rgba(169, 201, 238, 0.18); border-radius: 24px;
    padding: 28px; display: flex; flex-direction: column; gap: 8px;
  }
  .principle__title { font-family: var(--font-display); font-weight: 600; font-size: 20px; color: #FFFFFF; }
  .principle__body { color: var(--on-dark); }

  /* ---------- Process ---------- */
  .process { position: relative; padding-top: 96px; padding-bottom: 96px; display: flex; flex-direction: column; gap: 36px; }
  .steps { position: relative; display: flex; flex-wrap: wrap; gap: 24px; }
  .steps::before {
    content: ""; position: absolute; left: 24px; right: 24px; top: 34px; height: 2px;
    background: repeating-linear-gradient(90deg, var(--line-sky) 0 8px, transparent 8px 16px);
  }
  .step {
    position: relative; flex: 1 1 260px; background: #FFFFFF; border: 1px solid var(--line); border-radius: 24px; padding: 28px;
    display: flex; flex-direction: column; gap: 10px;
  }
  .step__num {
    width: 44px; height: 44px; border-radius: 50%; background: var(--tint); color: #174A82;
    font-family: var(--font-display); font-weight: 700; font-size: 18px; display: flex; align-items: center; justify-content: center;
    border: 3px solid var(--page);
  }
  .step__title { font-family: var(--font-display); font-weight: 600; font-size: 20px; color: var(--night); }
  .step__body { color: var(--ink-2); font-size: 16px; }

  /* ---------- Founding partners (hidden by default) ---------- */
  .founding { position: relative; padding-bottom: 96px; display: flex; flex-direction: column; gap: 28px; }
  .spots { position: relative; display: flex; flex-wrap: wrap; gap: 16px; }
  .spot {
    flex: 1 1 220px; min-height: 120px; border: 1.5px dashed var(--line-sky); border-radius: 22px;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px;
    color: var(--muted); background: rgba(255, 255, 255, 0.6); padding: 20px; text-align: center;
  }
  .spot__title { font-weight: 700; color: #174A82; }
  .spot__body { font-size: 14px; }

  /* ---------- CTA ---------- */
  .cta { position: relative; padding: 0 24px 112px; }
  .cta__card {
    max-width: 1240px; margin: 0 auto; background: var(--sky); border: 1px solid var(--line-sky); border-radius: 36px;
    padding: 88px 32px 112px; position: relative; overflow: hidden;
    display: flex; flex-direction: column; gap: 20px; align-items: center; text-align: center;
    box-shadow: 0 30px 80px rgba(37, 99, 168, 0.18);
  }
  .cta__horizon { position: absolute; left: 50%; bottom: -560px; width: 1100px; height: 640px; margin-left: -550px; }
  .cta__title { position: relative; font-size: clamp(2.2rem, 4.6vw, 3.6rem); line-height: 1.05; }
  .cta__lead { position: relative; margin: 0; max-width: 34rem; font-size: 19px; color: var(--ink-2); }
  .cta__actions { position: relative; display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; }
  .cta__actions :global(.button) { padding-left: 30px; padding-right: 30px; }
</style>
