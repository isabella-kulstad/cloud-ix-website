---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SkyHero from '../../components/SkyHero.astro';
import PageIntro from '../../components/PageIntro.astro';
import { routes } from '../../data/site';

const deliverables = [
  { title: 'HECVAT', body: 'The completed Higher Education Community Vendor Assessment Toolkit. [Confirm version, e.g. HECVAT 3]' },
  { title: 'Privacy policy', body: 'How student data is collected, encrypted, stored and protected.' },
  { title: 'Statement of work', body: 'Scope, onboarding timeline and support for your campus.' },
  { title: '[Optional: architecture or data-flow overview]', body: '[Add if you have one — security teams often ask.]' },
];

const nextSteps = [
  { title: 'Submit the form', body: 'Tell us who you are and which documents you need.' },
  { title: 'We verify your institution', body: 'A member of our team confirms your request within [1 business day].' },
  { title: 'Documents arrive securely', body: 'Sent to your institutional email — plus an optional walkthrough call.' },
];

const teams = ['Title IX', 'IT / Security', 'Procurement', 'Student affairs', 'Other'];
const docs = ['HECVAT', 'Privacy policy', 'Statement of work'];
const timelines = ['This month', 'This semester', 'Just exploring'];

const faqs = [
  { q: 'Do you require an NDA?', a: '[Yes / No — describe. Many vendors share HECVAT freely and reserve detailed architecture docs for after an NDA.]' },
  { q: 'Can you fill out our own security questionnaire?', a: '[Yes — attach it to your request or mention it in the notes, and we’ll return it within X business days.]' },
  { q: 'Where is student data hosted?', a: '[Hosting provider and region — confirm.]' },
  { q: 'Who can we talk to directly?', a: 'Our cofounders handle security reviews personally. Check the walkthrough box and we’ll set up a call.' },
];

const checkPath = '<path d="m5 12 5 5L20 7"></path>';
---
<BaseLayout title="Request our HECVAT" description="Everything your IT, security and procurement teams need to review Cloud IX — sent securely to your institutional email.">
  <SkyHero
    clouds={[
      { top: 130, width: 260, duration: 90, delay: -40 },
      { top: 60, width: 150, duration: 70, delay: -5 },
    ]}
    shoots={[]}
  >
    <PageIntro
      align="start"
      pad={[40, 220]}
      gap={18}
      titleSize="clamp(2.3rem, 4.4vw, 3.6rem)"
      titleMaxWidth="18ch"
      leadMaxWidth="40rem"
      lead="Everything your IT, security and procurement teams need to review Cloud IX — sent securely to your institutional email."
    >
      <Fragment slot="title">Request our <span class="glowtext hl">HECVAT</span> and security documents</Fragment>
      <nav aria-label="Breadcrumb" class="crumbs"><a href={routes.universities}>For universities</a> <span aria-hidden="true">›</span> Security documentation</nav>
    </PageIntro>
  </SkyHero>

  <section class="container body" aria-label="Request security documents">
    <!-- Left: what you get -->
    <div class="info">
      <div class="info__group">
        <h2 class="info__h">What you’ll receive</h2>
        {deliverables.map((d) => (
          <div class="card panel deliverable">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2563A8" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={checkPath}></svg>
            <div class="stack"><span class="stack__title">{d.title}</span><span class="stack__body">{d.body}</span></div>
          </div>
        ))}
      </div>
      <div class="info__group info__group--next">
        <h2 class="info__h">What happens next</h2>
        <ol class="next">
          {nextSteps.map((s, i) => (
            <li class="next__item">
              <span class="next__num" aria-hidden="true">{i + 1}</span>
              <div class="stack"><span class="stack__title">{s.title}</span><span class="stack__body">{s.body}</span></div>
            </li>
          ))}
        </ol>
      </div>
      <div class="panel notice">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#2563A8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3Z"></path><path d="m9 12 2 2 4-4"></path></svg>
        <p>We share security documentation only with verified institutional email addresses. [Note if an NDA is required before sharing.]</p>
      </div>
    </div>

    <!-- Right: form card -->
    <div class="card form-card" data-hecvat>
      <form class="form" novalidate data-form aria-labelledby="form-h">
        <div class="form__head">
          <h2 id="form-h" class="form__title">Request documents</h2>
          <p class="form__hint">Takes about a minute. Fields marked * are required.</p>
        </div>
        <div class="row">
          <label class="fld">Full name *
            <input class="fld__input" type="text" name="name" autocomplete="name" placeholder="Jordan Lee" required />
          </label>
          <label class="fld">Job title
            <input class="fld__input" type="text" name="title" autocomplete="organization-title" placeholder="Director of IT Security" />
          </label>
        </div>
        <div class="row">
          <label class="fld">Institution *
            <input class="fld__input" type="text" name="institution" autocomplete="organization" placeholder="Your university" required />
          </label>
          <label class="fld">Work email *
            <input class="fld__input" type="email" name="email" autocomplete="email" placeholder="name@university.edu" required />
          </label>
        </div>
        <fieldset class="group">
          <legend>Your team</legend>
          <div class="chips">
            {teams.map((t) => (
              <label class="chip"><input class="chip__input" type="radio" name="team" value={t} /><span class="chip__face">{t}</span></label>
            ))}
          </div>
        </fieldset>
        <fieldset class="group">
          <legend>Documents needed *</legend>
          <div class="chips">
            {docs.map((d) => (
              <label class="chip chip--doc"><input class="chip__input" type="checkbox" name="docs" value={d} checked /><span class="chip__face">{d}</span></label>
            ))}
          </div>
        </fieldset>
        <fieldset class="group">
          <legend>Review timeline</legend>
          <div class="chips">
            {timelines.map((t) => (
              <label class="chip"><input class="chip__input" type="radio" name="timeline" value={t} /><span class="chip__face">{t}</span></label>
            ))}
          </div>
        </fieldset>
        <label class="fld">Anything we should know?
          <textarea class="fld__input fld__input--area" name="notes" rows="3" placeholder="e.g. your procurement deadline, or a specific questionnaire you use"></textarea>
        </label>
        <label class="call">
          <input class="chip__input" type="checkbox" name="walkthrough" />
          <span class="call__box" aria-hidden="true"></span>
          Also schedule a 30-minute security walkthrough with our team
        </label>
        <p class="form__error" role="alert" data-error hidden></p>
        <button type="submit" class="btn form__submit">Send my request</button>
        <p class="form__legal">By submitting, you agree to our <a href={routes.privacy}>privacy policy</a>. We’ll only use your details to respond to this request.</p>
      </form>

      <div class="rise done" data-done hidden>
        <div class="bob done__badge" aria-hidden="true">
          <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#2563A8" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" set:html={checkPath}></svg>
        </div>
        <h2 class="done__title" tabindex="-1" data-done-title>Request received</h2>
        <p class="done__lead">Thanks, <span data-first-name>there</span>. We’ll verify <span data-inst-name>your institution</span> and send your documents to <strong data-email-shown></strong> within [1 business day].</p>
        <div class="done__summary">
          <span class="stack__title">You requested</span>
          <span class="text-2" data-doc-summary></span>
          <span class="text-2" data-wants-call hidden>Plus a 30-minute security walkthrough — we’ll email times that work.</span>
        </div>
        <div class="done__actions">
          <a class="btn done__btn done__btn--primary" href={routes.universities}>Back to For universities</a>
          <button type="button" class="btn done__btn done__btn--outline" data-reset>Submit another request</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Mini FAQ -->
  <section aria-labelledby="hfaq-h" class="container mini-faq">
    <h2 id="hfaq-h" class="display mini-faq__h">Common questions from IT &amp; procurement</h2>
    <div class="mini-faq__grid">
      {faqs.map((f) => (
        <div class="card panel mini-faq__card">
          <h3 class="h3 mini-faq__q">{f.q}</h3>
          <p class="mini-faq__a">{f.a}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-hecvat]');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const done = root.querySelector<HTMLElement>('[data-done]')!;
    const errorEl = root.querySelector<HTMLElement>('[data-error]')!;
    const q = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;
    let tried = false;

    const check = () => {
      const name = field('name').value.trim();
      const inst = field('institution').value.trim();
      const email = field('email').value.trim();
      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
      const docs = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="docs"]:checked')).map((d) => d.value);
      const missing: string[] = [];
      if (!name) missing.push('your name');
      if (!inst) missing.push('your institution');
      if (!emailOk) missing.push('a valid work email');
      if (!docs.length) missing.push('at least one document');
      return { name, inst, email, docs, missing, valid: { name: !!name, institution: !!inst, email: emailOk } };
    };

    // Mirrors the design: errors (red borders + message) appear only after a submit attempt,
    // then update live as the visitor fixes them.
    const paint = () => {
      const r = check();
      (Object.keys(r.valid) as (keyof typeof r.valid)[]).forEach((k) => {
        const bad = tried && !r.valid[k];
        field(k).toggleAttribute('aria-invalid', bad);
      });
      const showError = tried && r.missing.length > 0;
      errorEl.hidden = !showError;
      errorEl.textContent = showError ? `Please add ${r.missing.join(', ')}.` : '';
      return r;
    };

    form.addEventListener('input', () => { if (tried) paint(); });
    form.addEventListener('change', () => { if (tried) paint(); });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      tried = true;
      const r = paint();
      if (r.missing.length) return;

      // TODO: send the request to the backend (e.g. POST new FormData(form) to the
      // security-docs endpoint / CRM) once one exists. For now we only show the success state.

      q<HTMLElement>('[data-first-name]').textContent = r.name.split(/\s+/)[0] || 'there';
      q<HTMLElement>('[data-inst-name]').textContent = r.inst || 'your institution';
      q<HTMLElement>('[data-email-shown]').textContent = r.email;
      q<HTMLElement>('[data-doc-summary]').textContent = r.docs.join(' · ');
      q<HTMLElement>('[data-wants-call]').hidden = !field('walkthrough').checked;
      form.hidden = true;
      done.hidden = false;
      tried = false;
      q<HTMLElement>('[data-done-title]').focus({ preventScroll: true });
      root.scrollIntoView({ block: 'start' });
    });

    q<HTMLButtonElement>('[data-reset]').addEventListener('click', () => {
      form.reset();
      tried = false;
      paint();
      done.hidden = true;
      form.hidden = false;
      field('name').focus({ preventScroll: true });
      root.scrollIntoView({ block: 'start' });
    });
  }
</script>

<style>
  .crumbs { order: -1; font-size: 15px; color: var(--muted); }
  .crumbs a { color: #174A82; font-weight: 600; text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }

  /* ---------- Body ---------- */
  .body {
    position: relative; z-index: 2;
    margin-top: -170px; padding-bottom: 104px;
    display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-start;
  }

  .info { flex: 1 1 400px; min-width: 0; display: flex; flex-direction: column; gap: 24px; padding-top: 196px; }
  .info__group { display: flex; flex-direction: column; gap: 14px; }
  .info__group--next { margin-top: 8px; }
  .info__h { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 26px; color: var(--night); }
  .deliverable { display: flex; gap: 14px; align-items: flex-start; border-radius: 18px; padding: 18px 20px; }
  .deliverable svg { flex: none; margin-top: 3px; }
  .stack { display: flex; flex-direction: column; gap: 2px; }
  .stack__title { font-weight: 700; color: var(--night); }
  .stack__body { font-size: 15px; color: var(--ink-2); }

  .next { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 14px; }
  .next__item { display: flex; gap: 14px; align-items: flex-start; }
  .next__num {
    flex: none; width: 34px; height: 34px; border-radius: 50%;
    background: var(--tint); color: #174A82; font-family: var(--font-display); font-weight: 700;
    display: flex; align-items: center; justify-content: center;
  }

  .notice { display: flex; gap: 14px; align-items: flex-start; border-radius: 18px; padding: 18px 20px; }
  .notice svg { flex: none; margin-top: 2px; }
  .notice p { margin: 0; font-size: 15px; color: var(--ink-2); }

  /* ---------- Form card ---------- */
  .form-card {
    flex: 1 1 520px; min-width: 0; box-sizing: border-box;
    background: #FFFFFF; border: 1px solid var(--line-strong); border-radius: 32px; padding: 40px;
    box-shadow: 0 30px 80px rgba(37, 99, 168, 0.18);
  }
  .form { display: flex; flex-direction: column; gap: 22px; }
  .form[hidden], .done[hidden] { display: none; }
  .form__head { display: flex; flex-direction: column; gap: 6px; }
  .form__title { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 28px; color: var(--night); }
  .form__hint { margin: 0; color: var(--muted); font-size: 15px; }

  .row { display: flex; flex-wrap: wrap; gap: 16px; }
  .fld { flex: 1 1 220px; min-width: 0; display: flex; flex-direction: column; gap: 6px; font-weight: 600; font-size: 15px; color: var(--night); }
  .form > .fld { flex: none; }
  .fld__input {
    box-sizing: border-box; width: 100%;
    font: inherit; font-weight: 400; padding: 12px 14px;
    border: 1.5px solid #D5E2F2; border-radius: 12px; background: var(--page); color: var(--night);
  }
  .fld__input--area { resize: vertical; }
  .fld__input:focus { outline: 3px solid rgba(47, 111, 196, 0.35); outline-offset: 1px; border-color: var(--accent); }
  .fld__input[aria-invalid] { border-color: #D64545; }

  .group { border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .group legend { padding: 0; margin-bottom: 10px; font-weight: 600; font-size: 15px; color: var(--night); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }

  /* Native radios / checkboxes, visually hidden; the label face carries the design's chip look. */
  .chip { position: relative; display: inline-flex; cursor: pointer; }
  .chip__input { position: absolute; opacity: 0; width: 1px; height: 1px; margin: 0; pointer-events: none; }
  .chip__face {
    display: inline-flex; gap: 6px; align-items: center;
    padding: 10px 16px; border-radius: 999px; font-weight: 600; font-size: 15px;
    color: var(--night); background: #FFFFFF; border: 1.5px solid var(--line-strong);
    transition: background-color .2s ease, color .2s ease, border-color .2s ease;
  }
  .chip__input:checked + .chip__face { color: #FFFFFF; background: var(--accent); border-color: var(--accent); }
  .chip__input:focus-visible + .chip__face { outline: 3px solid var(--accent); outline-offset: 2px; }
  .chip--doc .chip__face::before { content: '+'; }
  .chip--doc .chip__input:checked + .chip__face::before { content: '✓'; }

  .call { position: relative; display: flex; gap: 12px; align-items: center; color: var(--ink); font-size: 16px; cursor: pointer; }
  .call__box {
    flex: none; width: 24px; height: 24px; box-sizing: border-box; border-radius: 7px;
    display: flex; align-items: center; justify-content: center; color: #FFFFFF;
    background: #FFFFFF; border: 1.5px solid var(--line-strong);
  }
  .call .chip__input:checked + .call__box { background: var(--accent); border-color: var(--accent); }
  .call .chip__input:checked + .call__box::before { content: '✓'; }
  .call .chip__input:focus-visible + .call__box { outline: 3px solid var(--accent); outline-offset: 2px; }

  .form__error { margin: 0; padding: 12px 16px; border-radius: 12px; background: #FDECEC; color: #9B1C1C; font-size: 15px; font-weight: 600; }
  .form__error[hidden] { display: none; }

  .form__submit {
    align-self: stretch; cursor: pointer; font: inherit; text-align: center;
    color: #FFFFFF; background: var(--accent); border: 0;
    padding: 16px 28px; border-radius: 999px; font-weight: 700; font-size: 17px;
  }
  .form__legal { margin: 0; text-align: center; font-size: 13px; color: var(--muted); }

  /* ---------- Success ---------- */
  .done { display: flex; flex-direction: column; gap: 22px; align-items: center; text-align: center; padding: 24px 0; }
  .done__badge {
    width: 120px; height: 120px; border-radius: 50%; background: var(--tint);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 0 0 10px var(--page), 0 0 50px rgba(37, 99, 168, 0.3);
  }
  .done__title { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 32px; color: var(--night); }
  .done__title:focus { outline: none; }
  .done__lead { margin: 0; color: var(--ink-2); font-size: 18px; max-width: 28rem; }
  .done__lead strong { color: var(--night); overflow-wrap: anywhere; }
  .done__summary {
    align-self: stretch; text-align: left; background: var(--page); border: 1px solid var(--line);
    border-radius: 18px; padding: 20px 22px; display: flex; flex-direction: column; gap: 10px;
  }
  .done__summary [hidden] { display: none; }
  .done__actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .done__btn { font: inherit; font-weight: 700; padding: 14px 24px; border-radius: 999px; text-decoration: none; cursor: pointer; }
  .done__btn--primary { color: #FFFFFF; background: var(--accent); border: 0; }
  .done__btn--primary:hover { color: #FFFFFF; }
  .done__btn--outline { color: var(--night); background: transparent; border: 1.5px solid var(--line-strong); }

  /* ---------- Mini FAQ ---------- */
  .mini-faq { padding-bottom: 112px; display: flex; flex-direction: column; gap: 28px; }
  .mini-faq__h { font-size: clamp(1.8rem, 3vw, 2.3rem); letter-spacing: -0.02em; }
  .mini-faq__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 20px; }
  .mini-faq__card { border-radius: 22px; padding: 26px 28px; display: flex; flex-direction: column; gap: 8px; }
  .mini-faq__q { font-size: 19px; }
  .mini-faq__a { margin: 0; color: var(--ink-2); font-size: 16px; }
</style>
