---
import BaseLayout from '../layouts/BaseLayout.astro';
import SkyHero from '../components/SkyHero.astro';
import PageIntro from '../components/PageIntro.astro';
import LegalDoc from '../components/LegalDoc.astro';
import { routes } from '../data/site';

const subprocessors = [
  { name: 'Google Cloud Platform (GCP)', entity: 'Google LLC', purpose: 'Cloud hosting, infrastructure and data storage for the Platform', location: 'United States' },
  { name: 'GitHub / GitLab', entity: 'GitHub, Inc. / GitLab Inc.', purpose: 'Source-code hosting and version control', location: 'United States' },
  { name: 'Jenkins', entity: 'Jenkins (open source)', purpose: 'Build and deployment automation', location: 'United States' },
  { name: 'Prometheus', entity: 'Prometheus (open source)', purpose: 'System monitoring and alerting', location: 'United States' },
  { name: 'Grafana', entity: 'Grafana Labs', purpose: 'Monitoring dashboards', location: 'United States' },
  { name: 'LangChain', entity: 'LangChain, Inc.', purpose: 'AI application framework used to run Sky', location: 'United States' },
];
---
<BaseLayout title="Subprocessors" description="The third-party services that help us host and run the Cloud IX platform.">
  <SkyHero>
    <PageIntro pill="Legal" gap={16} lead="The third-party services that help us host and run the Cloud IX platform.">
      <Fragment slot="title">Our <span class="glowtext hl">subprocessors</span></Fragment>
    </PageIntro>
  </SkyHero>

  <LegalDoc title="Cloud IX Subprocessors" updated="November 16, 2026">
    <p>Subprocessors are third-party companies that Cloud IX uses to host and operate the Platform. They may process personal information on our behalf, only to provide services to Cloud IX. As described in our <a href={routes.privacy}>Privacy Notice</a>, they are bound by contract to use data only to serve Cloud IX and to protect it to our standards.</p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th scope="col">Subprocessor</th><th scope="col">Entity</th><th scope="col">Purpose</th><th scope="col">Data location</th></tr>
        </thead>
        <tbody>
          {subprocessors.map((s) => (
            <tr><td>{s.name}</td><td>{s.entity}</td><td>{s.purpose}</td><td>{s.location}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <h3>Changes to this list</h3>
    <p>We update this page when we add or replace a subprocessor. Institutions are notified of changes as described in our Privacy Notice and their Services Agreement.</p>
    <h3>Questions</h3>
    <p>Contact <a href="mailto:support@cloud-ix.com">support@cloud-ix.com</a>. IT and procurement teams can also <a href={routes.hecvat}>request our security documentation</a>.</p>
  </LegalDoc>
</BaseLayout>
