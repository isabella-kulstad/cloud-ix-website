---
import { external } from '../data/site';
---
<a class="btn quick-exit" href={external.quickExit} aria-label="Quick exit: leave this site now">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"></path></svg>Quick exit
</a>
<script>
  // Quick exit: replace this page in history so Back doesn't return here.
  const link = document.querySelector<HTMLAnchorElement>('.quick-exit');
  const leave = (e?: Event) => {
    e?.preventDefault();
    if (link) window.location.replace(link.href);
  };
  link?.addEventListener('click', leave);
</script>
<style>
  .quick-exit {
    position: fixed; right: 20px; bottom: calc(20px + env(safe-area-inset-bottom, 0px)); z-index: 60;
    display: inline-flex; align-items: center; gap: 8px; padding: 14px 22px; border-radius: 999px;
    background: var(--night); color: #FFFFFF; font-weight: 700; font-size: 16px; text-decoration: none;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.95), 0 12px 32px rgba(14, 34, 64, 0.35);
  }
  .quick-exit:hover { color: #FFFFFF; }
</style>
