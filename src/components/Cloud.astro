---
/** A single drifting cloud. Position it with `top`; `duration`/`delay` in seconds. */
interface Props {
  top: number;
  width: number;
  duration: number;
  delay?: number;
  fill?: string;
  opacity?: number;
}
const { top, width, duration, delay = 0, fill = '#FFFFFF', opacity = 0.85 } = Astro.props;
---
<svg
  class="drift"
  style={`top:${top}px;width:${width}px;opacity:${opacity};animation-duration:${duration}s;animation-delay:${delay}s`}
  viewBox="0 -30 200 110"
  aria-hidden="true"
><path d="M40 78h120a28 28 0 0 0 2-55.9A40 40 0 0 0 86 14a30 30 0 0 0-46 64Z" fill={fill}></path></svg>
